---
interface Props {
    id: string
}

const { id } = Astro.props
---

<button type="submit" id={id} class="w-full flex justify-center text-white bg-primary hover:bg-teal-800 focus:ring-4 font-medium rounded-lg text-m px-5 py-2.5 dark:bg-teal-800 dark:hover:bg-primary dark:focus:ring-blue-800 disabled:bg-blue-900 disabled:cursor-not-allowed disabled:hover:bg-blue-900 transition-all cursor-pointer">
    <slot/>
</button>