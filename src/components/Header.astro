---
import NavLink from "./NavLink.astro"
import ProfileButton from "./ProfileButton.astro"
import NotificationsButton from "./NotificationsButton.astro"
---

<header class="bg-white/80 dark:bg-gray-950 shadow-md rounded-b-xl py-2 px-4">
    <div class="flex flex-col justify-between items-center grow xl:flex-row max-w-7xl mx-auto">
        <figure>
            <a href="/home" class="text-center lg:mr-22">
                <span class="font-black text-3xl text-accent">Vox</span>
                <span class="font-black text-3xl text-primary">Pet</span>
            </a>
        </figure>
        <nav>
            <ul class="flex gap-6">
                <li><NavLink link="/home">Inicio</NavLink></li>
                <li><NavLink link="/mascotas">Mis mascotas</NavLink></li>
                <li><NavLink link="/citas">Citas</NavLink></li>
            </ul>
        </nav>
        <figure class="flex gap-3 items-center">
            <NotificationsButton />
            <ProfileButton />
        </figure>
    </div>
</header>