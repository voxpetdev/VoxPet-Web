<label class="rounded-full p-2 flex justify-center items-center gap-2 cursor-text shadow-md bg-white">
    <slot name="icon"/>
    <input class="outline-none w-full" type={Astro.props.type} name={Astro.props.name} id={Astro.props.name} placeholder={Astro.props.placeholder}>
    <slot name="status"/>
</label>

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    input[type=number] {
      -moz-appearance: textfield;
    }
</style>