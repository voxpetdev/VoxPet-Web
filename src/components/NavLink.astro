---
interface Props{
    link:string
}
const {link}= Astro.props
---
<a href={link} class="relative cursor-pointer before:content-[''] before:absolute before:left-0 before:-bottom-1 before:w-full before:h-[2px] before:bg-green-900 before:scale-x-0 before:origin-left before:transition-transform before:duration-300 hover:before:scale-x-100 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200">
    <slot/>
</a>
