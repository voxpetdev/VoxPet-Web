---
import BellIcon from "@/icons/BellIcon.astro"
---

<button class="cursor-pointer border border-gray-200 dark:text-gray-400 text-gray-500 hover:text-gray-700 hover:bg-gray-100 dark:border-gray-800 dark:bg-gray-900 dark:hover:bg-gray-800 dark:hover:text-white transition-colors rounded-full p-1.5 relative">
    <span class="absolute right-0 top-0.5 z-10 h-2 w-2 rounded-full bg-orange-400 flex">
        <span class="absolute inline-flex w-full h-full bg-orange-400 rounded-full opacity-75 animate-ping"></span>
    </span>
    <BellIcon />
</button>