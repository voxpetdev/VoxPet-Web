---
interface Props {
    name: string
}

const { name } = Astro.props
---
<label class="rounded-full p-2 flex justify-center items-center gap-2 cursor-text shadow-md bg-white">
    <slot name="icon"/>
    <select class="w-full outline-none" name={name} id={name}>
        <slot/>
    </select>
</label>
