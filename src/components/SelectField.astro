---
interface Props {
    name: string
}

const { name } = Astro.props
---
<select class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-min p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white" name={name} id={name}>
    <slot/>
</select>
