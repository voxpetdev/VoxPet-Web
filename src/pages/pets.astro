---
import Layout from "@/layouts/Principal-layout.astro"
import PetsSection from "@/sections/PetsSection.astro"

const cookie = Astro.cookies.get("access_token")?.value
if (!cookie) return Astro.redirect('/')
---

<Layout title="Mis mascotas">
    <PetsSection server:defer>
        <div class="w-full h-full grid place-items-center" slot="fallback">
            <h1 class="text-4xl font-semibold">Cargando...</h1>
        </div>
    </PetsSection>
</Layout>