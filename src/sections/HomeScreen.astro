---
import Calendar from "@/icons/Calendar.astro";
import Paw from "@/icons/Paw.astro";
import Calendar2 from "@/icons/Calendar2.astro";
import Banner from "@/assets/home.png"
import Image from "astro/components/Image.astro"
---
<main class="max-w-7xl w-full mx-auto flex flex-col justify-center gap-4">
  <figure>
    <Image src={Banner} alt="Home Banner" inferSize class="rounded-2xl"/>
  </figure>
  <section class="flex gap-4">
    <button class="flex items-center gap-6 bg-orange-100 p-6 rounded-2xl shadow-md border border-orange-200 w-full hover:bg-orange-200 hover:shadow-lg transition-all duration-200 cursor-pointer">
        <figure class="text-orange-600 p-3 bg-white rounded-2xl shadow-md">
          <Calendar2 class="h-8 w-8" />
        </figure>
        <div>
          <p class="font-extrabold text-green-900 text-2xl">Próxima Cita</p>
          <p class="text-lg text-gray-700">Luna, Viernes 3:00pm</p>
        </div>
    </button>
    <a href="dates" class="flex items-center gap-6 bg-emerald-100 p-6 rounded-2xl shadow-md border border-emerald-200 w-full hover:bg-emerald-200 hover:shadow-lg transition-all duration-200 cursor-pointer">
      <figure class="text-emerald-600 bg-white p-3 rounded-xl shadow-sm">
        <Calendar class="w-8 h-8" />
      </figure>
      <div>
        <p class="font-extrabold text-green-900 text-2xl">Pedir Cita</p>
      </div>
    </a>
    <a href="pets" class="flex items-center gap-6 bg-emerald-100 p-6 rounded-2xl shadow-md border border-emerald-200 w-full hover:bg-emerald-200 hover:shadow-lg transition-all duration-200 cursor-pointer">
      <figure class="text-emerald-600 bg-white p-3 rounded-xl shadow-sm">
        <Paw class="w-8 h-8" />
      </figure>
      <div>
        <p class="font-extrabold text-green-900 text-2xl">Mis mascotas</p>
      </div>
    </a>
  </section>
</main>
