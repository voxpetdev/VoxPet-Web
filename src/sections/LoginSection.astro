---
import LOGO from "@/assets/LOGO.svg";
import Input from "@/components/Input.astro";
---

<section class="grid place-content-center min-h-dvh">
  <form id="loginForm" class="flex flex-col gap-6 bg-white shadow-md border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700 p-6 max-w-[448px]" method="POST">
    <img src={LOGO.src} alt="Descripción de la imagen" class="w-34 h-auto rounded-lg mx-auto"/>
    <h3 class="text-center -mt-3">
      <span class="font-black text-5xl text-[#B392B7]">Vox</span>
      <span class="font-black text-5xl text-primary">Pet</span>
    </h3>
    <p class="text-sm text-center text-gray-400">
      Acceda, gestione y centralice la información de sus mascotas
    </p>
    <Input type="email" id="email" placeholder="Email" required />

    <Input type="password" id="password" placeholder="Contraseña" required />

    <article class="flex justify-between">
      <div>
        <input
          id="remember"
          aria-describedby="remember"
          type="checkbox"
          class="bg-gray-50 border border-gray-300 h-3.5 w-3.5 rounded dark:bg-gray-200 dark:border-gray-600 ring-offset-0 ring-0"
        />
        <label for="remember" class="font-medium text-[#073F4E] dark:text-gray-300">
          Recuérdame
        </label>
      </div>
      <a href="#" class="text-sm font-light text-secondary-600 hover:underline dark:text-primary-500">
        Olvidaste la contraseña?
      </a>
    </article>

    <button type="submit" id="submit" class="w-full flex justify-center text-white bg-primary hover:bg-teal-800 focus:ring-4 font-medium rounded-lg text-m px-5 py-2.5 dark:bg-teal-800 dark:hover:bg-primary dark:focus:ring-blue-800 disabled:bg-blue-900 disabled:cursor-not-allowed disabled:hover:bg-blue-900 transition-all cursor-pointer">
      Iniciar sesión
    </button>

    <p class="text-sm text-center text-gray-400">O inicia sesión con</p>
    <hr class="-my-2 border-gray-300 dark:border-gray-600" />

    <button type="button" class="flex items-center justify-center gap-2 w-full border border-gray-300 rounded-lg px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer">
      <svg
        {...Astro.props}
        width="24"
        height="24"
        viewBox="0 0 256 262"
        xmlns="http://www.w3.org/2000/svg" 
        preserveAspectRatio="xMidYMid">
        <path d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027" fill="#4285F4"></path>
        <path d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1" fill="#34A853"></path>
        <path d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782" fill="#FBBC05"></path>
        <path d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251" fill="#EB4335"></path>
      </svg>
    </button>

    <article class="flex gap-2 text-sm font-light text-gray-500 dark:text-gray-300">
      <p>No estás registrado?</p>
      <a href="/register" class="font-bold text-[#073F4E] hover:underline dark:text-blue-500">
        Crea una cuenta
      </a>
    </article>
  </form>
</section>

<style is:inline>
  .loading-icon {
    animation: spin 1s linear infinite;
    vertical-align: middle;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import Swal from "sweetalert2"
  const form = document.getElementById("loginForm") as HTMLFormElement
  const submitButton = document.getElementById("submit") as HTMLButtonElement

  const loadingSVG = `
    <svg
        class="loading-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M12 3a9 9 0 1 0 9 9"></path>
    </svg>
    `

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()

      submitButton.disabled = true
      submitButton.innerHTML = loadingSVG

      const data = {
        username: form.email.value,
        password: form.password.value
      }

      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })

        if(res.ok) {
          Swal.fire({
            icon: 'success',
            title: 'Bienvenido',
            text: 'Inicio de sesión exitoso!',
            theme: 'auto'
          })
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error...',
            text: 'El nombre de usuario o contraseña no coinciden.',
            theme: 'auto'
          })
        }
      } catch (error) {
        console.error(error)
        Swal.fire({
          icon: 'error',
          title: 'Error de conexión',
          text: 'No se pudo conectar con el servidor.',
          theme: 'auto'
        })
      } finally {
        submitButton.disabled = false
        submitButton.innerHTML = "Iniciar Sesión"
      }
    })
</script>
