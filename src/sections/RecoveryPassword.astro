---
import Input from "@/components/Input.astro"
import FormButton from "@/components/FormButton.astro"

// Icons
import BackIcon from "@/icons/BackIcon.astro"
---

<a href="/" class="flex gap-1 items-center m-4 float-left absolute font-bold text-[#073F4E] hover:underline dark:text-blue-500" title="Ir al inicio"><BackIcon/> Volver</a>

<section class="grid place-content-center min-h-dvh p-4">
  <div
    class="bg-white shadow-md border border-gray-200 rounded-2xl p-8 
           w-full md:w-[520px] lg:w-[600px] flex flex-col gap-6"
  >
    <h1 class="text-4xl font-semibold text-black">Recuperar contraseña</h1>

    <p class="text-sm text-gray-500">
      Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
    </p>

    <form method="post" class="flex flex-col gap-4 mt-2">
      <Input id="email" type="email" placeholder="Correo electrónico" />
    </form>

    <FormButton id="submit">Enviar</FormButton>
  </div>
</section>

