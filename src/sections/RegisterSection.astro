---
// Components
import InputField from "@/components/InputField.astro"
import FormButton from "@components/FormButton.astro"
import SelectField from "@components/SelectField.astro"

// Icons
import CheckIcon from '@icons/CheckIcon.astro'
import LockIcon from "@/icons/LockIcon.astro"
import MailIcon from "@/icons/MailIcon.astro"
import WritingIcon from "@icons/WritingIcon.astro"
import WritingSignIcon from "@icons/WritingSignIcon.astro"
import DocumentIcon from "@icons/DocumentIcon.astro"
import PhoneIcon from "@icons/PhoneIcon.astro"
---
<section class="grid place-content-center min-h-dvh">
    <fieldset {... Astro.props}>
        <h1 class="text-4xl font-bold text-purple-500">Formulario de registro</h1>
        <form method="post" class="flex flex-col gap-4">
            <InputField type="text" name="name" placeholder="Nombre">
                <WritingSignIcon slot='icon' class="text-gray-500 pointer-none"/>
            </InputField>
            <InputField type="text" name="last_name" placeholder="Apellido">
                <WritingIcon slot='icon' class="text-gray-500 pointer-none"/>
            </InputField>
            <SelectField name="documentType">
                <DocumentIcon slot='icon' class="text-gray-500 pointer-none"/>
                <option value="" selected disabled>Selecciona tu tipo de documento</option>
                <option value="cc">CC</option>
                <option value="ti">TI</option>
                <option value="pt">PPT</option>
            </SelectField>
            <InputField type="number" name="document" placeholder="Documento">
                <DocumentIcon slot='icon' class="text-gray-500 pointer-none"/>
            </InputField>
            <InputField type="text" name="phone" placeholder="Telefono">
                <PhoneIcon slot='icon' class="text-gray-500 pointer-none"/>
            </InputField>
            <InputField type="email" name="email" placeholder="Email">
                <MailIcon slot='icon' class="text-gray-500 pointer-none"/>
                <CheckIcon slot='status' class="text-green-500"/>
            </InputField>
            <InputField type="password" name="password" placeholder="Contraseña">
                <LockIcon slot="icon" class="text-gray-500 pointer-none"/>
            </InputField>
            <InputField type="password" name="confirmPassword" placeholder="Confirmar contraseña">
                <LockIcon slot="icon" class="text-gray-500 pointer-none"/>
            </InputField>
            <FormButton>
                Registrarse
            </FormButton>
        </form>
    </fieldset>
</section>