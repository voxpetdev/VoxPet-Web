---
// Components
import FormButton from "@components/FormButton.astro"
import SelectField from "@components/SelectField.astro"
import Input from "@/components/Input.astro"
import LOGO from "@/assets/LOGO.svg"

// Icons
import BackIcon from "@/icons/BackIcon.astro"
import GoogleIcon from "@/icons/GoogleIcon.astro"
---
<a href="/" class="flex gap-1 items-center m-4 float-left absolute font-bold text-[#073F4E] hover:underline dark:text-blue-500" title="Ir al inicio"><BackIcon/> Volver</a>
<section class="grid place-content-center min-h-dvh md:p-6 overflow-x-hidden">
    <h2 class="font-bold text-4xl mb-4 hidden lg:block">Registrate</h2>
    <form id="registerform" method="post" class="flex flex-col-reverse lg:flex-row gap-6 md:bg-white shadow-md md:border border-gray-200 rounded-lg md:dark:bg-gray-800 dark:border-gray-700 p-2 md:p-6">
        <div class="flex flex-col gap-4 min-w-0 md:min-w-[448px]">
            <h1 class="flex w-fit lg:hidden text-2xl">Registro</h1>
            <Input id="name" type="text" placeholder="Nombre"/>
            <Input id="last_name" type="text" placeholder="Apellido"/>
            <div class="flex gap-2">
                <SelectField name="documentType" class="max-w-fit">
                    <option value="" selected disabled>tipo</option>
                    <option value="cc">CC</option>
                    <option value="ti">TI</option>
                    <option value="pt">PPT</option>
                </SelectField>
                <Input id="document" type="number" placeholder="Documento"/>
            </div>
            <Input id="phone" type="text" placeholder="Telefono"/>
            <Input id="email" type="email" placeholder="Email"/>
            <Input id="password" type="password" placeholder="Contraseña"/>
            <Input id="confirmPassword" type="password" placeholder="Confirmar contraseña"/>
            <FormButton id="submit">
                Registrarse
            </FormButton>
        </div>

        <div class="flex flex-col gap-6 min-w-0 md:min-w-[448px]">
            <img src={LOGO.src} alt="Descripción de la imagen" style="aspect-ratio: 295/311;" class="w-32 mx-auto"/>
            <h3 class="text-center -mt-3">
                <span class="font-black text-5xl text-[#B392B7]">Vox</span>
                <span class="font-black text-5xl text-primary">Pet</span>
            </h3>

            <p class="text-sm text-center text-gray-400">Crea tu perfil para acceder al sistema</p>
            <p class="text-sm text-center text-gray-400">O ingresa con</p>
            
            <button type="button" class="flex items-center justify-center gap-2 w-full border border-gray-300 rounded-lg px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer">
                <GoogleIcon/>
            </button>
            
            <article class="flex gap-2 text-sm font-light text-gray-500 dark:text-gray-300">
                <p>Ya estas registrado?</p>
                <a href="/" class="font-bold text-[#073F4E] hover:underline dark:text-blue-500">
                    Inicia sesión
                </a>
            </article>
            <hr class="-my-2 block lg:hidden border-gray-300 dark:border-gray-600" />
        </div>
    </form>
</section>

<script>
    import Swal from "sweetalert2"
    const form = document.getElementById("registerform") as HTMLFormElement
    const submitButton = document.getElementById("submit") as HTMLButtonElement

    form?.addEventListener('submit', async (e) => {
        e.preventDefault()

        submitButton.disabled = true
        submitButton.innerHTML = '<span class="loading loading-spinner"></span>'

        const formData = new FormData(form)
        const data = {
            name: formData.get('name'),
            last_name: formData.get('last_name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            password: formData.get('password')
        }

        try {
            const res = await fetch('/api/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })

            if(res.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Registro exitoso!',
                    text: 'Continua con la verificación de tu cuenta por medio de tu correo electronico.',
                    theme: 'auto'
                }).then(() => window.location.href = "/")
            } else {
                const resJson = await res.json()
                Swal.fire({
                    icon: 'error',
                    title: 'Error...',
                    text: resJson.message,
                    theme: 'auto'
                })
            }
        } catch (error) {
            console.error(error)
            Swal.fire({
                icon: 'error',
                title: 'Error de conexión',
                text: 'No se pudo conectar con el servidor.',
                theme: 'auto'
            })
        }   finally {
            submitButton.disabled = false
            submitButton.innerHTML = "Registrarse"
        }
    })
</script>